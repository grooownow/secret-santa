{
  "name": "gridfin",
  "version": "0.7.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "next build && tsx scripts/check-function-traces.ts",
    "start": "next start --port 3210",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && eslint . && prettier --check . && tsc --noEmit",
    "secrets:scan": "secretlint \"**/*\"",
    "format": "prettier --write .",
    "gates": "tsx scripts/gates.ts",
    "gates:show": "tsx scripts/gates.ts --show",
    "gates:note": "tsx scripts/gates.ts --note",
    "bootstrap": "./scripts/bootstrap",
    "release": "./scripts/release",
    "skills:gen": "tsx scripts/gen-skills.ts",
    "skills:check": "tsx scripts/gen-skills.ts --check",
    "skills:validate": "tsx scripts/validate-skills.ts",
    "modules:validate": "tsx scripts/validate-modules.ts",
    "module:apply": "tsx scripts/apply-module.ts",
    "i18n:check": "tsx marketing/landing/scripts/i18n-check.ts",
    "landing:build": "tsx marketing/landing/scripts/build.ts",
    "skills:evals": "tsx scripts/skill-evals.ts",
    "skills:evals:behavioral": "tsx scripts/skill-evals.ts --behavioral",
    "skills:evals:detection": "tsx scripts/skill-detection-eval.ts",
    "prepare": "lefthook install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -rf .pglite && pnpm db:migrate && pnpm db:seed"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@auth/drizzle-adapter": "^1.11.2",
    "@electric-sql/pglite": "^0.5.4",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.23.0",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "posthog-js": "^1.398.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.2",
    "eslint-plugin-oxlint": "^1.73.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.9",
    "oxlint": "^1.73.0",
    "postcss": "^8.5.24",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "secretlint": "^13.0.4",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
