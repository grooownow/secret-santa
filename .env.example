# --- App ---
# Public app URL, used in metadata (sitemap, robots, OG). Default: http://localhost:3210
# NEXT_PUBLIC_APP_URL=https://example.com

# --- Observability (all optional) ---
# Sentry DSN for server + edge error reporting (request errors, via
# instrumentation.ts's onRequestError hook). No source-map upload is
# configured here — see src/sentry.server.config.ts for why, and set up
# SENTRY_AUTH_TOKEN in your deploy pipeline when you're ready for that.
# SENTRY_DSN=
# Same Sentry DSN, mirrored with the NEXT_PUBLIC_ prefix to also enable
# browser-side error capture (src/instrumentation-client.ts). DSNs are not
# secrets — safe to expose client-side. Separate var because only
# NEXT_PUBLIC_-prefixed vars are inlined into client bundles.
# NEXT_PUBLIC_SENTRY_DSN=
# Log verbosity: fatal | error | warn | info | debug | trace (default: info)
# LOG_LEVEL=info

# --- Analytics (all optional) ---
# PostHog public API key (browser-exposed via NEXT_PUBLIC_ prefix)
# NEXT_PUBLIC_POSTHOG_KEY=

# --- Database & auth (persistence module) ---
# Database: pglite (default, zero deps) | remote (needs DATABASE_URL)
GRIDFIN_DB=pglite
# DATABASE_URL=postgres://gridfin:gridfin@localhost:5432/gridfin
# Required for any auth flow. Generate with: openssl rand -base64 33
# AUTH_SECRET=
# Set to true when self-hosting behind a trusted proxy (Vercel is auto-trusted).
# AUTH_TRUST_HOST=
# Google OAuth client
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Seeded admin login (dev defaults shown; the seed refuses to run in production).
# SEED_ADMIN_EMAIL=admin@example.local
# SEED_ADMIN_PASSWORD=dev-admin-pw

# --- Secret Santa (all optional in dev) ---
# The organizer: the verified account with this email gets /admin
# (case-insensitive). In dev, set it to SEED_ADMIN_EMAIL to open /admin.
# ADMIN_EMAIL=admin@example.local
# Gmail account used to send mail, with a 2-step-verification app password.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# Shared secret for the daily cron endpoint (Vercel sends it as a Bearer token).
# CRON_SECRET=
# Vercel Blob read/write token for photos.
# BLOB_READ_WRITE_TOKEN=
# Groq API key (console.groq.com, free tier) for auto-translating wishes and
# wall posts. Without it: a fake translator in dev, translation off in production.
# GROQ_API_KEY=
# Swap the model here if Groq deprecates it (default: llama-3.3-70b-versatile).
# GROQ_MODEL=
# E2E only (set by playwright.config.ts): append mail to this file instead of
# sending it. The app refuses to boot with it on Vercel, with Gmail
# credentials, or with a non-local NEXT_PUBLIC_APP_URL. Never set it in prod.
# E2E_MAIL_OUTBOX=
